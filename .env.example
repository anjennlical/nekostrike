# Optional Mochi AI. Copy to .env at repository root; loaded ONLY by the backend.
# Local security checks need none of these settings. Never use VITE_ for secrets.
# Leave disabled until you authorize provider charges and understand data sharing.
MOCHI_AI_ENABLED=false
OPENAI_API_KEY=
# Choose an account-accessible model supporting Responses + Structured Outputs.
MOCHI_AI_MODEL=
MOCHI_AI_TIMEOUT_SECONDS=45
MOCHI_AI_MAX_INPUT_BYTES=12000
MOCHI_AI_MAX_OUTPUT_TOKENS=4096
# Per backend process, including failed attempts. Restart resets this counter.
# These limits are NOT a monetary budget. Use provider-side spending controls too.
MOCHI_AI_MAX_REQUESTS=3
